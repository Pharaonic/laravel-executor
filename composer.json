{
    "name": "pharaonic/laravel-executor",
    "description": "Run one-time and recurring deployment tasks on your Laravel servers: Artisan commands, jobs and custom actions, tracked in batches with rollback, tags and per-server targeting.",
    "keywords": [
        "laravel",
        "executor",
        "deployment",
        "deploy tasks",
        "artisan",
        "rollback",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        },
        {
            "name": "Karim Mohamed (Komtcho)",
            "email": "komicho1996@gmail.com"
        },
        {
            "name": "Moemen Gaballa",
            "email": "moemengaballa@gmail.com"
        }
    ],
    "support": {
        "docs": "https://pharaonic.dev/packages/laravel/executor",
        "issues": "https://github.com/Pharaonic/laravel-executor/issues",
        "source": "https://github.com/Pharaonic/laravel-executor"
    },
    "require": {
        "php": ">=8.2 <8.5",
        "laravel/framework": "^11.0",
        "pharaonic/php-dot-array": "~8.2.1 || ~8.3.1 || ~8.4.2",
        "pharaonic/php-smart-enum": "~8.2.0 || ~8.3.0 || ~8.4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Executor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Executor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Executor\\ExecutorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "security": "@composer audit",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore": {
                    "laravel/framework": "No fixed release within Laravel 11; the application chooses the framework release."
                }
            }
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
